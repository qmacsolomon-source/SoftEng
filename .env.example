# =============================================================================
#  APA Engineering Services - Project Management System
#  Copy this file to ".env" and fill in the real values from your Supabase
#  project dashboard:  Project Settings -> API
#  NEVER commit the real ".env" file.
# =============================================================================

# --- Server -----------------------------------------------------------------
# Port the Express server listens on.
PORT=3000
# "development" gives verbose errors; "production" hides stack traces.
NODE_ENV=development

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key. Safe to use on the server for user-scoped requests.
# This key is NEVER sent to the browser - the browser only talks to /api/*.
SUPABASE_ANON_KEY=your-anon-public-key

# SECRET service-role key. Bypasses Row Level Security.
# Used server-side ONLY for admin tasks (creating/deleting auth users).
# NEVER expose this in frontend code, NEVER commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Application ------------------------------------------------------------
# Secret used to sign nothing user-visible; keep random.
APP_SECRET=change-me-to-a-long-random-string

# Comma separated list of allowed browser origins.
# Leave as-is for local development.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Upload limits ----------------------------------------------------------
MAX_UPLOAD_MB=5
